{
  "name": "open-banking",
  "version": "0.0.0",
  "private": true,
  "description": "A local emulator and server compatible with the LHV Connect API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx server/src/main.ts",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test 'server/test/**/*.test.ts'",
    "coverage": "c8 --include 'server/src/**' --exclude server/src/main.ts --reporter text --reporter text-summary --reporter html --report-dir .rec/coverage npm test",
    "check": "scripts/check.sh",
    "dev-ca": "scripts/dev-ca.sh",
    "fetch-reference": "scripts/fetch-reference.sh"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
